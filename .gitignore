# Flow outputs — regenerate with `astra run <design>`, never commit.
runs/
astra-image.tar.gz

*.log
__pycache__/
*.pyc
.DS_Store

# graphify code knowledge graph. The report, the graph JSON and the interactive
# HTML are tracked so the graph is browsable from the repo without a local
# install. Everything else under graphify-out/ is not: the rebuild cache and
# the dated backup directories are several MB, churn on every rebuild, and
# regenerate from source in seconds.
#
# Note the tracked three are DERIVED. They go stale the moment code changes --
# GRAPH_REPORT.md records the commit it was built from, so check that before
# trusting it, and run `graphify update .` to refresh.
graphify-out/*
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.json
!graphify-out/graph.html

runs.zip
