# ---------------------------------------------------------------------------
# soc_bench timing constraints — five asynchronous domains.
#
# @ASTRA_CLOCK_DEFS@ is generated by tools/clocks.py from the `clocks` list in
# config.json. It expands to a create_clock for each master, a
# create_generated_clock for each divider, and the set_clock_groups
# -asynchronous that separates the five independent masters.
#
# That last command is not cosmetic. Without it every clock domain crossing is
# analysed as a setup path between clocks with no phase relationship, which
# reports as an enormous violation. Those violations are not real, and they
# would dominate TNS and swamp the criticality distribution the portfolio
# ranks on — the selector would spend every agent call on a crossing that must
# not be touched. See docs/equivalence-contract.md.
# ---------------------------------------------------------------------------
# --- generated by tools/clocks.py -------------------------------
create_clock -name clk_sys -period 2 [get_ports {clk_sys}]
create_clock -name clk_dsp -period 3 [get_ports {clk_dsp}]
create_clock -name clk_mem -period 4 [get_ports {clk_mem}]
create_clock -name clk_aux -period 5 [get_ports {clk_aux}]
create_clock -name clk_io -period 8 [get_ports {clk_io}]
create_generated_clock -name clk_sys_div2 -source [get_ports {clk_sys}] -divide_by 2 [get_pins {clk_sys_div2_r_DFFR_X1_Q/Q}]
create_generated_clock -name clk_dsp_div2 -source [get_ports {clk_dsp}] -divide_by 2 [get_pins {clk_dsp_div2_r_DFFR_X1_Q/Q}]
create_generated_clock -name clk_dsp_div4 -source [get_pins {clk_dsp_div2_r_DFFR_X1_Q/Q}] -divide_by 2 [get_pins {clk_dsp_div2_r_DFFR_X1_CK/Q}]
create_generated_clock -name clk_mem_div2 -source [get_ports {clk_mem}] -divide_by 2 [get_pins {clk_mem_div2_r_DFFR_X1_Q/Q}]
create_generated_clock -name clk_mem_div4 -source [get_pins {clk_mem_div2_r_DFFR_X1_Q/Q}] -divide_by 2 [get_pins {clk_mem_div4_r_DFFR_X1_Q/Q}]
create_generated_clock -name clk_mem_div8 -source [get_pins {clk_mem_div4_r_DFFR_X1_Q/Q}] -divide_by 2 [get_pins {clk_mem_div4_r_DFFR_X1_CK/Q}]
create_generated_clock -name clk_aux_div2 -source [get_ports {clk_aux}] -divide_by 2 [get_pins {clk_aux_div2_r_DFFR_X1_Q/Q}]
create_generated_clock -name clk_io_div2 -source [get_ports {clk_io}] -divide_by 2 [get_pins {clk_io_div2_r_DFFR_X1_Q/Q}]

# Independent masters have no phase relationship; crossings
# between them are not setup paths.
set_clock_groups -asynchronous -group {clk_sys clk_sys_div2} -group {clk_dsp clk_dsp_div2 clk_dsp_div4} -group {clk_mem clk_mem_div2 clk_mem_div4 clk_mem_div8} -group {clk_aux clk_aux_div2} -group {clk_io clk_io_div2}

# Modest margin so post-synthesis numbers are not wildly optimistic.
foreach c [all_clocks] {
    set_clock_uncertainty 0.05 $c
    set_clock_transition  0.05 $c
}

# OpenSTA has no `remove_from_collection` (that is a Synopsys command), so
# drop the clock ports from the input list by name.
set clk_ports {clk_sys clk_dsp clk_io clk_mem clk_aux}
set rst_ports {rst_sys_n rst_dsp_n rst_io_n rst_mem_n rst_aux_n}

set inputs_no_clk {}
foreach p [all_inputs] {
    if {[lsearch -exact $clk_ports [get_full_name $p]] == -1} {
        lappend inputs_no_clk $p
    }
}

# Select ports by walking the collection and matching the name in Tcl.
#
# NOT with a get_ports pattern. OpenSTA 3.1.0 cannot parse a bus subscript in
# one: `get_ports {sys_a[*]}` fails with a bare `Error: stoi` and no line
# number, because it reads the subscript as an integer. Matching here avoids
# its pattern parser entirely. `$base\[*` also keeps sys_a from swallowing
# sys_acc, which a loose `sys_a*` glob would.
proc astra_ports {collection bases} {
    set out {}
    foreach p $collection {
        set n [get_full_name $p]
        foreach b $bases {
            if {$n eq $b || [string match "${b}\[*" $n]} {
                lappend out $p
                break
            }
        }
    }
    return $out
}

# Each domain's ports are constrained against that domain's own clock, which
# is the whole point of the multi-clock model: a 15% budget on an 8 ns clock
# is four times the budget of 15% on a 2 ns one.
set all_in  [all_inputs]
set all_out [all_outputs]

set_input_delay  -clock clk_sys [expr {2 * 0.15}] \
    [astra_ports $all_in {sys_valid sys_a sys_b}]
set_input_delay  -clock clk_dsp [expr {3 * 0.15}] \
    [astra_ports $all_in {dsp_valid dsp_sample dsp_coef_we dsp_coef_in}]
set_input_delay  -clock clk_io  [expr {8 * 0.15}] \
    [astra_ports $all_in {io_rx_valid io_rx_byte io_req}]
set_input_delay  -clock clk_mem [expr {4 * 0.15}] \
    [astra_ports $all_in {mem_search mem_tag}]
set_input_delay  -clock clk_aux [expr {5 * 0.15}] \
    [astra_ports $all_in {aux_valid aux_data}]

set_output_delay -clock clk_sys [expr {2 * 0.15}] \
    [astra_ports $all_out {sys_acc sys_sat}]
set_output_delay -clock clk_dsp [expr {3 * 0.15}] \
    [astra_ports $all_out {dsp_corr}]
set_output_delay -clock clk_io  [expr {8 * 0.15}] \
    [astra_ports $all_out {io_status io_grant io_frame_ok}]
set_output_delay -clock clk_mem [expr {4 * 0.15}] \
    [astra_ports $all_out {mem_hit_idx mem_hit}]
set_output_delay -clock clk_aux [expr {5 * 0.15}] \
    [astra_ports $all_out {aux_crc aux_parity}]

# PDK-neutral drive/load model: no library cell names, so the same SDC works
# on nangate45 and sky130hd.
set_input_transition 0.05 $inputs_no_clk
set_load             0.02 [all_outputs]

set_max_fanout    20  [current_design]
set_max_transition 0.5 [current_design]

# Resets are asynchronous by construction; keep them out of the datapath
# timing picture so the reported critical paths are the five datapaths.
foreach r $rst_ports {
    set_false_path -from [get_ports $r]
}
