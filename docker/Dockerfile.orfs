# ============================================================================
# ASTRA — VLSI container
#
#   Yosys      logic synthesis
#   OpenSTA    static timing analysis
#   OpenROAD   place & route
#   PDKs       nangate45 (default) + sky130hd, asap7, gf180
#
# The ORFS base image already ships Yosys, OpenROAD and the PDKs, so the only
# thing layered on top is a standalone OpenSTA.
#
#   docker buildx build --platform linux/amd64 -t astra:latest -f docker/Dockerfile .
# ============================================================================
ARG ORFS_IMAGE=openroad/orfs:latest
FROM ${ORFS_IMAGE}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        git curl ca-certificates build-essential cmake \
        bison flex swig tcl-dev tk-dev libreadline-dev \
        zlib1g-dev libeigen3-dev python3 jq less \
    && rm -rf /var/lib/apt/lists/*

# OpenSTA. OpenROAD embeds the same engine, so if the source build fails we
# install a shim over `openroad -no_init` rather than losing the image. Which
# one you got is recorded here and printed by `astra doctor` — never silent.
RUN set -euo pipefail; \
    if git clone --depth 1 https://github.com/parallaxsw/OpenSTA.git /tmp/OpenSTA \
       && cmake -S /tmp/OpenSTA -B /tmp/OpenSTA/build -DCMAKE_BUILD_TYPE=Release \
       && cmake --build /tmp/OpenSTA/build -j"$(nproc)" \
       && cmake --install /tmp/OpenSTA/build; then \
        echo "opensta=native (standalone build)" >> /etc/astra-tools.txt; \
    else \
        echo "!!! OpenSTA source build FAILED — installing openroad-backed shim" >&2; \
        printf '#!/bin/bash\nexec openroad -no_init "$@"\n' > /usr/local/bin/sta; \
        chmod +x /usr/local/bin/sta; \
        echo "opensta=shim (openroad -no_init)" >> /etc/astra-tools.txt; \
    fi; \
    rm -rf /tmp/OpenSTA

ENV ASTRA_ROOT=/work \
    ASTRA_PDK_ROOT=/OpenROAD-flow-scripts/flow/platforms \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /work

# Baked in so the image works standalone; bind-mounting the repo over /work
# shadows this copy and picks up host edits without a rebuild.
COPY flow    /work/flow
COPY tools   /work/tools
COPY designs /work/designs

RUN chmod +x /work/tools/*.py && ln -sf /work/tools/astra.py /usr/local/bin/astra

COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]
